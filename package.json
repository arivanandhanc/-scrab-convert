{
  "name": "scrab-convert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LibreOffice conversion worker. Portable across any host that can run a container.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "bootstrap": "node deploy/bootstrap.mjs",
    "deploy-lambda": "node deploy/deploy-lambda.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "cors": "^2.8.5"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ecr": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-budgets": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0"
  }
}
